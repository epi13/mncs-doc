mncs 0.18;
module mncs.doc.provider.v1;
use mncs.doc.state.v1 as roadmap;
use doctor.projection.v1 as projection;
use mncs.commons.family.provenance.v1 as provenance;
use doctor.provider.v1 as doctor;

fn milestone(verdict: u64, current: u64, dependencies: u64, blocker: u64) -> (result: u64) {
    return roadmap.milestone(verdict, current, dependencies, blocker);
}
fn health(source: u64, present: u64, owned: u64, boundaries: u64,
          unchanged: u64, renderer: u64, epoch: u64, validated: u64, blocked: u64) -> (status: u64) {
    return projection.health(source, present, owned, boundaries, unchanged, renderer, epoch, validated, blocked);
}
fn state(expected: [byte; 32], built: [byte; 32], known: u64, present: u64, intact: u64) -> (result: u64) {
    return provenance.artifact_state(expected, built, known, present, intact);
}
fn repair(state: u64, owner: u64, confined: u64, authority: u64, attempts: u64) -> (result: u64) {
    return doctor.repair_artifact(state, owner, confined, authority, attempts);
}
