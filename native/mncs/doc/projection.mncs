mncs 0.18;

// mncs.doc.projection.v1 — document projection admission policy.
//
// A document projection replaces one machine-owned region of a
// human-authored document with bytes derived from authoritative
// sources. The host finds marker spans and classifies them through
// mncs.doc.region; this module decides whether the projection may
// proceed. Ambiguous regions are never admitted: the machine must not
// rewrite human prose it cannot bound exactly. Missing regions are
// creatable only when the caller allows creation. A projection with
// no sources or no template is refused: generated bytes must always
// derive from something.
//
// Region status codes are shared with mncs.doc.region: 0 Missing,
// 1 Invalid, 2 Valid. Admission reasons: 0 admitted, 1 no-sources,
// 2 no-template, 3 ambiguous-region, 4 create-forbidden,
// 5 unknown-status.
module mncs.doc.projection.v1;

use mncs.test.assertions;
use mncs.test.suite;

enum ProjectionReason { Admitted, NoSources, NoTemplate, AmbiguousRegion, CreateForbidden, UnknownStatus }

record ProjectionInput {
    region_status: u64,
    create_allowed: u64,
    source_count: u64,
    template_present: u64
}

record ProjectionVerdict { admit: bool, reason: u64 }

fn region_missing() -> (code: u64) {
    return 0;
}

fn region_invalid() -> (code: u64) {
    return 1;
}

fn region_valid() -> (code: u64) {
    return 2;
}

fn reason_code(reason: ProjectionReason) -> (code: u64) {
    return match reason {
        Admitted => 0,
        NoSources => 1,
        NoTemplate => 2,
        AmbiguousRegion => 3,
        CreateForbidden => 4,
        UnknownStatus => 5,
    };
}

fn admit(input: ProjectionInput) -> (result: ProjectionVerdict) {
    if input.region_status > region_valid() {
        return ProjectionVerdict { admit: false, reason: reason_code(ProjectionReason.UnknownStatus) };
    }
    if input.region_status == region_invalid() {
        return ProjectionVerdict { admit: false, reason: reason_code(ProjectionReason.AmbiguousRegion) };
    }
    if input.region_status == region_missing() && input.create_allowed == 0 {
        return ProjectionVerdict { admit: false, reason: reason_code(ProjectionReason.CreateForbidden) };
    }
    if input.source_count == 0 {
        return ProjectionVerdict { admit: false, reason: reason_code(ProjectionReason.NoSources) };
    }
    if input.template_present == 0 {
        return ProjectionVerdict { admit: false, reason: reason_code(ProjectionReason.NoTemplate) };
    }
    return ProjectionVerdict { admit: true, reason: reason_code(ProjectionReason.Admitted) };
}

// Scalar-argument boundary entry point for host callers.
fn admit_fields(region_status_value: u64, create_allowed_value: u64, source_count_value: u64, template_present_value: u64) -> (result: ProjectionVerdict) {
    return admit(ProjectionInput {
        region_status: region_status_value,
        create_allowed: create_allowed_value,
        source_count: source_count_value,
        template_present: template_present_value
    });
}

test admit_valid_region() -> (result: TestResult) {
    let verdict: ProjectionVerdict = admit_fields(2, 0, 3, 1);
    let ok: bool = verdict.admit && verdict.reason == reason_code(ProjectionReason.Admitted);
    return from_assertion(equals_bool(true, ok, 5501));
}

test refuse_ambiguous_region() -> (result: TestResult) {
    let verdict: ProjectionVerdict = admit_fields(1, 1, 3, 1);
    let ok: bool = verdict.admit == false && verdict.reason == reason_code(ProjectionReason.AmbiguousRegion);
    return from_assertion(equals_bool(true, ok, 5502));
}

test missing_region_needs_create_allowed() -> (result: TestResult) {
    let verdict: ProjectionVerdict = admit_fields(0, 0, 3, 1);
    let ok: bool = verdict.admit == false && verdict.reason == reason_code(ProjectionReason.CreateForbidden);
    return from_assertion(equals_bool(true, ok, 5503));
}

test missing_region_with_create_admits() -> (result: TestResult) {
    let verdict: ProjectionVerdict = admit_fields(0, 1, 3, 1);
    let ok: bool = verdict.admit && verdict.reason == reason_code(ProjectionReason.Admitted);
    return from_assertion(equals_bool(true, ok, 5504));
}

test refuse_projection_without_sources() -> (result: TestResult) {
    let verdict: ProjectionVerdict = admit_fields(2, 0, 0, 1);
    let ok: bool = verdict.admit == false && verdict.reason == reason_code(ProjectionReason.NoSources);
    return from_assertion(equals_bool(true, ok, 5505));
}

test refuse_projection_without_template() -> (result: TestResult) {
    let verdict: ProjectionVerdict = admit_fields(2, 0, 3, 0);
    let ok: bool = verdict.admit == false && verdict.reason == reason_code(ProjectionReason.NoTemplate);
    return from_assertion(equals_bool(true, ok, 5506));
}

test refuse_unknown_region_status() -> (result: TestResult) {
    let verdict: ProjectionVerdict = admit_fields(9, 1, 3, 1);
    let ok: bool = verdict.admit == false && verdict.reason == reason_code(ProjectionReason.UnknownStatus);
    return from_assertion(equals_bool(true, ok, 5507));
}
